LANGUAGE 0x09, 0x01

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004
 FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
            VALUE "ProductName", "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
