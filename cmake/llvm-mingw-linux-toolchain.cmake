# LLVM-MinGW portable para compilación cruzada desde Linux (Codex Cloud).
# Este archivo solo produce PE/COFF x64. Los ejecutables se prueban en runner Windows.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(PM_TOOLCHAIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../tools/toolchains/llvm-mingw-linux" ABSOLUTE)
set(PM_TARGET_TRIPLE "x86_64-w64-windows-gnu")
set(PM_SYSROOT "${PM_TOOLCHAIN_ROOT}/${PM_TARGET_TRIPLE}")
if(NOT EXISTS "${PM_TOOLCHAIN_ROOT}/bin/clang++")
  message(FATAL_ERROR "LLVM-MinGW Linux missing. Run tools/bootstrap-codex-cloud.sh first.")
endif()
if(NOT EXISTS "${PM_SYSROOT}/include/windows.h")
  message(FATAL_ERROR "Windows headers missing from LLVM-MinGW sysroot: ${PM_SYSROOT}")
endif()
set(CMAKE_CXX_COMPILER "${PM_TOOLCHAIN_ROOT}/bin/clang++")
set(CMAKE_CXX_COMPILER_TARGET "${PM_TARGET_TRIPLE}")
set(CMAKE_SYSROOT "${PM_SYSROOT}")
set(CMAKE_RC_COMPILER "${PM_TOOLCHAIN_ROOT}/bin/llvm-rc")
set(CMAKE_AR "${PM_TOOLCHAIN_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${PM_TOOLCHAIN_ROOT}/bin/llvm-ranlib")
set(CMAKE_STRIP "${PM_TOOLCHAIN_ROOT}/bin/llvm-strip")
set(CMAKE_LINKER "${PM_TOOLCHAIN_ROOT}/bin/ld.lld")
set(CMAKE_FIND_ROOT_PATH "${PM_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
