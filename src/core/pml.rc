#include <windows.h>

#define IDI_PML_ICON     101
#define IDI_PML_ICON_RED 102

IDI_PML_ICON     ICON "pml.ico"
IDI_PML_ICON_RED ICON "pml_red.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,2,1
 PRODUCTVERSION 0,2,2,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PortableManager Lite Project"
            VALUE "FileDescription", "PortableManager Lite"
            VALUE "FileVersion", "0.2.2-beta.1"
            VALUE "InternalName", "pml.exe"
            VALUE "OriginalFilename", "pml.exe"
            VALUE "ProductName", "PortableManager Lite"
            VALUE "ProductVersion", "0.2.2-beta.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
